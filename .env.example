OPENAI_API_KEY="your-api-key-here"
# OPENAI_API_BASE_URL: your LLM API endpoint — a cloud OpenAI-compatible API
# (e.g. https://api.openai.com/v1) or a locally hosted LLM
# (e.g. http://localhost:9101/v1). Legacy alias OPENAI_BASE_URL also
# works (OPENAI_API_BASE_URL wins when both are set).
OPENAI_API_BASE_URL="https://api.openai.com/v1"
DATASET_PATH="./data"
# TAVILY_API_KEY: web search backend for the agent's escalation path
# (https://tavily.com). Missing/empty key makes web escalation return empty
# results so the agent rejects gracefully instead of crashing.
TAVILY_API_KEY="your-tavily-api-key-here"
# CONFIDENCE_THRESHOLD: minimum grounding score (0..1) an answer must have
# to be returned — the maximum embedding-cosine similarity between the
# answer and any single retrieved record (faithfulness). Below it the
# answer is replaced by the rejection message. Defaults to 0.65.
CONFIDENCE_THRESHOLD="0.55"
# RETRIEVAL_SCORE_THRESHOLD: minimum query↔chunk cosine (0..1) a retrieved
# chunk must have to be returned by hybrid search; below it the chunk is
# dropped as irrelevant. Defaults to 0.3.
RETRIEVAL_SCORE_THRESHOLD="0.3"
# AGENT_TEMPERATURE / ANSWER_TEMPERATURE: per-call-type sampling temperature.
# The agent tool-use loop defaults to 0.0 for deterministic tool decisions;
# the RAG answer step defaults to 0.3. Set both to "1" for reasoning models
# (o1/o3) that reject temperature != 1.
AGENT_TEMPERATURE="0.0"
ANSWER_TEMPERATURE="0.3"
# MODEL_ID is REQUIRED — no default fallback. Set it to your model name.
# gpt-5.6-luna is OpenAI's current lightweight tier (function calling +
# structured outputs + Responses API, ~$0.20/$1.20 per MTok) — good enough
# for this RAG. Swap in your local model when using a local endpoint.
# In Docker, a localhost/127.0.0.1 base URL is automatically rewritten to host.docker.internal.
MODEL_ID="gpt-5.6-luna"
# Postgres connection for the monitoring store (conversations, spans,
# searches, llm_calls, feedback) — used by the app, dashboards, and
# docker-compose. Defaults below target a local capstone server
# (docker-compose overrides POSTGRES_HOST/PORT inside the app container;
# its postgres service maps host port 5433 -> container 5432).
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="capstone"
POSTGRES_USER="capstone"
POSTGRES_PASSWORD="capstone_secret"
# TRACING_ENABLED: OpenTelemetry span export (spans land in Postgres).
# Defaults to enabled ("1"); set to "0" (or false/no/off) to disable, e.g.
# for environments without a writable store.
TRACING_ENABLED="1"
