OPENAI_API_KEY="your-api-key-here"
# OPENAI_API_BASE_URL: your LLM API endpoint — a locally hosted LLM
# (e.g. http://localhost:9101/v1) or a cloud OpenAI-compatible API
# (e.g. https://api.openai.com/v1).
OPENAI_API_BASE_URL="http://localhost:9101/v1"
DATASET_PATH="./data"
# TAVILY_API_KEY: web search backend for the agent's escalation path
# (https://tavily.com). Missing/empty key makes web escalation return empty
# results so the agent rejects gracefully instead of crashing.
TAVILY_API_KEY="your-tavily-api-key-here"
# CONFIDENCE_THRESHOLD: minimum judge confidence (0..1) for an answer to be
# returned; below it the agent escalates or rejects. Defaults to 0.7.
CONFIDENCE_THRESHOLD="0.7"
# JUDGE_TEMPERATURE / ANSWER_TEMPERATURE: per-call-type sampling temperature.
# The judge (verdict + grounded answer) defaults to 0.0 for deterministic
# verdicts; the RAG answer step defaults to 0.3. Set both to "1" for
# reasoning models (o1/o3) that reject temperature != 1.
JUDGE_TEMPERATURE="0.0"
ANSWER_TEMPERATURE="0.3"
# MODEL_ID is REQUIRED — no default fallback. Set it to your model name.
# In Docker, a localhost/127.0.0.1 base URL is automatically rewritten to host.docker.internal.
MODEL_ID="qwen/qwen3.5-9b"
