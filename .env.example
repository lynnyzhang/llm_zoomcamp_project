OPENAI_API_KEY="your-api-key-here"
# OPENAI_API_BASE_URL: your LLM API endpoint — a locally hosted LLM
# (e.g. http://localhost:9101/v1) or a cloud OpenAI-compatible API
# (e.g. https://api.openai.com/v1).
OPENAI_API_BASE_URL="http://localhost:9101/v1"
DATASET_PATH="./data"
# MODEL_ID is REQUIRED — no default fallback. Set it to your model name.
# In Docker, a localhost/127.0.0.1 base URL is automatically rewritten to host.docker.internal.
MODEL_ID="qwen/qwen3.5-9b"
